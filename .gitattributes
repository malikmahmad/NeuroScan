# Linguist overrides for language statistics
notebooks/*.ipynb linguist-language=Jupyter Notebook
notebooks/*.py linguist-language=Python
*.ipynb linguist-language=Jupyter Notebook

# Treat these as documentation, not code
*.md linguist-documentation
*.txt linguist-documentation

# Deprioritize generated/vendor code
frontend/dist/* linguist-generated
frontend/node_modules/* linguist-vendored
backend/venv*/* linguist-vendored
